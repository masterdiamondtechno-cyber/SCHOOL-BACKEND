    {
      "name": "04 - SaaS Subscription Management & Razorpay",
      "description": "Lifecycle management of school subscriptions, trial activations, and payments",
      "item": [
        {
          "name": "Start 14-Day Free Trial",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/subscription/trial/{{school_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "subscription", "trial", "{{school_id}}"]
            },
            "description": "Starts 14 days full-access free trial for the school."
          },
          "response": []
        },
        {
          "name": "Create Razorpay Order (Auto-saves razorpay_order_id)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 or 201', function () {",
                  "    pm.expect([200, 201]).to.include(pm.response.code);",
                  "});",
                  "var res = pm.response.json();",
                  "var d = res.data || res;",
                  "var oid = d.razorpayOrderId || d.orderId || d.id;",
                  "if (oid) {",
                  "    pm.collectionVariables.set('razorpay_order_id', oid);",
                  "    console.log('Saved Razorpay Order ID:', oid);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"planId\": {{plan_id}},\n  \"billingCycle\": \"MONTHLY\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/subscription/create-order/{{school_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "subscription", "create-order", "{{school_id}}"]
            },
            "description": "Creates Razorpay Payment order. In mock mode, returns a ready mock order ID."
          },
          "response": []
        },
        {
          "name": "Verify Payment & Activate Plan (Mock / Live)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Payment Verified', function () {",
                  "    pm.expect([200, 201]).to.include(pm.response.code);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"razorpayOrderId\": \"{{razorpay_order_id}}\",\n  \"razorpayPaymentId\": \"pay_mock_12345678\",\n  \"razorpaySignature\": \"mock_sig_12345678\",\n  \"planId\": {{plan_id}},\n  \"billingCycle\": \"MONTHLY\",\n  \"schoolId\": {{school_id}}\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/subscription/verify-payment/{{school_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "subscription", "verify-payment", "{{school_id}}"]
            },
            "description": "Validates cryptographic signature (or mock simulation) and upgrades the school subscription status."
          },
          "response": []
        },
