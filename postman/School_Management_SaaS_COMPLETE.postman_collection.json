    {
      "name": "09 - Security & Interceptor Tests",
      "description": "Validation test cases ensuring unauthorized and expired accounts are blocked",
      "item": [
        {
          "name": "Protected Route Without Token -> Expect 401 / 403",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Missing Token is Rejected', function () {",
                  "    pm.expect([401, 403]).to.include(pm.response.code);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/subscription/current/{{school_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "subscription", "current", "{{school_id}}"]
            },
            "description": "Validates that unauthenticated requests cannot access protected school endpoints."
          },
          "response": []
        },
        {
          "name": "Invalid JWT Token Signature -> Expect 401 / 403",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Forged Token Rejected', function () {",
                  "    pm.expect([401, 403]).to.include(pm.response.code);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJmYWtlQG1haWwuY29tIn0.invalidSignature"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/subscription/check/{{school_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "subscription", "check", "{{school_id}}"]
            },
            "description": "Validates that tampered JWT signatures fail verification."
          },
          "response": []
        },
        {
          "name": "Expired / Inactive School Interceptor -> Expect 403",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Subscription Interceptor Blocks Expired School', function () {",
                  "    pm.expect([403, 404, 401]).to.include(pm.response.code);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/subscription/check/9999",
              "host": ["{{base_url}}"],
              "path": ["api", "subscription", "check", "9999"]
            },
            "description": "Tests SubscriptionInterceptor blocking access when school has no active subscription."
          },
          "response": []
        }
      ]
    }
