            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "pm.test('Status is 200 or 201', function () {",
                  "    pm.expect([200, 201]).to.include(pm.response.code);",
                  "});",
                  "var sid = res.data ? (res.data.schoolId || res.data.id) : null;",
                  "if (sid) {",
                  "    pm.collectionVariables.set('school_id', sid);",
                  "    console.log('Saved school_id variable:', sid);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "schoolName", "value": "Delhi Public School Pune", "type": "text" },
                { "key": "email", "value": "dps_pune_admin@masterdiamond.in", "type": "text" },
                { "key": "phoneNo", "value": "9876501234", "type": "text" },
                { "key": "udiseNo", "value": "UDISE2721001", "type": "text" },
                { "key": "state", "value": "Maharashtra", "type": "text" },
                { "key": "district", "value": "Pune", "type": "text" },
                { "key": "taluka", "value": "Haveli", "type": "text" },
                { "key": "pincode", "value": "411038", "type": "text" },
                { "key": "schoolAddress", "value": "Kothrud Road, Pune, Maharashtra", "type": "text" },
                { "key": "principalName", "value": "Dr. Rajesh Sharma", "type": "text" }
              ]
