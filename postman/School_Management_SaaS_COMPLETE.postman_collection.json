        {
          "name": "School Login (Auto-saves JWT Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "pm.test('Status is 200 or 201', function () {",
                  "    pm.expect([200, 201]).to.include(pm.response.code);",
                  "});",
                  "var token = res.token || res.accessToken || (res.data && (res.data.token || res.data.accessToken || res.data.jwt));",
                  "if (token) {",
                  "    pm.collectionVariables.set('token', token);",
                  "    console.log('JWT Token successfully saved into {{token}}!');",
                  "    pm.test('Token found in response', function () { pm.expect(token).to.be.a('string'); });",
                  "} else {",
                  "    console.log('Token not found in response:', res);",
                  "}",
                  "var sid = res.data && (res.data.schoolId || res.data.id);",
                  "if (sid) {",
                  "    pm.collectionVariables.set('school_id', sid);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
